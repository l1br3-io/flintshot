[Desktop Entry]
Type=Application
Name=Flintshot
Comment=Capture and annotate screenshots
# The launcher entry opens the app window (capture home), which
# auto-starts the daemon when none is running (app-window effort;
# supersedes the launcher spec's "daemon is the app" primary-entry
# decision — ADR-0045). Quick captures ride the Desktop Actions.
Exec=flintshot app
Icon=flintshot
Terminal=false
Categories=Utility;Graphics;
Keywords=screenshot;capture;
Actions=region;fullscreen;
# StartupWMClass follows the window title (eframe/winit derive the
# class from the title, not argv[0]): the app window is titled
# "flintshot" — HOME_WINDOW_TITLE in
# crates/flintshot-editor-egui/src/shell.rs. (The editor window's
# class is "flintshot — annotate"; this entry tracks the window it
# launches.)
StartupWMClass=flintshot

[Desktop Action region]
Name=Capture region
Exec=flintshot region

[Desktop Action fullscreen]
Name=Capture fullscreen
Exec=flintshot fullscreen
