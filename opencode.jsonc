{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--isolated",
          "--executable-path",
          "/home/jpt/.local/bin/google-chrome"
        ]
      }
    }
  }
}
